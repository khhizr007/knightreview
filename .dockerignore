# Keep the build context small and free of local-only data.
.git
.claude
.kiro
**/node_modules
frontend/dist
backend/target
*.log

# Local-only material that must never ship (see .gitignore and THIRD_PARTY.md).
frontend/public/sounds
tests/calibration
tools/*
!tools/maia
!tools/sounds
captures
*.coach.json
*.keys.json
extension
.env
**/data/reviews
# A private opening book is mounted at run time (BOOK_FILE), never built into the image.
private
compose.override.yaml
*.bin
