# Keep the build context small and free of local-only data.
.git
.claude
.kiro
**/node_modules
frontend/dist
backend/target
*.log

# Local-only material that must never ship (see .gitignore and THIRD_PARTY.md).
tests/calibration
tools/*
!tools/maia
!tools/sounds
captures
*.coach.json
*.keys.json
extension
.env
**/data/reviews
# Local-only book copies and other binaries stay out.
private
compose.override.yaml
*.bin
# The shipped opening book is built into the image.
!backend/data/book/book.bin
